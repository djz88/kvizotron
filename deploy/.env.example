# Zkopíruj jako deploy/.env a doplň. Soubor .env nepatří do gitu.

# Doména, na které aplikace běží. Caddy pro ni získá certifikát.
# Jde i IP adresa v LAN: certifikát pak vydá lokální autorita Caddy a prohlížeč varuje.
KVZ_DOMAIN=

# Podepisuje tokeny pokusů a session. Vygeneruj: openssl rand -hex 32
# Změna zneplatní rozehrané pokusy a odhlásí adminy, měň ji jen bez otevřeného kola.
KVZ_SECRET_KEY=

# Volitelné, výchozí jsou 80 a 443.
# KVZ_HTTP_PORT=80
# KVZ_HTTPS_PORT=443
# Základní limity
KVZ_LOGIN_ATTEMPTS_PER_MINUTE=5
KVZ_CODE_ATTEMPTS_PER_MINUTE=10
KVZ_SUBMITS_PER_MINUTE=120
KVZ_STARTS_PER_MINUTE=300
KVZ_BACKUP_RETENTION_DAYS=10
KVZ_LOGIN_ADDRESS_ATTEMPTS_PER_MINUTE=30
