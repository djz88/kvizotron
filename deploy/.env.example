# Copy to deploy/.env and fill in. The .env file does not belong in git.

# The domain the application runs on. Caddy obtains a certificate for it.
# A LAN IP address works too: the certificate is then issued by Caddy's local authority and the browser warns.
KVZ_DOMAIN=

# Signs attempt tokens and sessions. Generate with: openssl rand -hex 32
# Changing it invalidates attempts in progress and logs admins out; change it only when no run is open.
KVZ_SECRET_KEY=

# Optional; the defaults are 80 and 443.
# KVZ_HTTP_PORT=80
# KVZ_HTTPS_PORT=443
# Basic limits
KVZ_LOGIN_ATTEMPTS_PER_MINUTE=5
KVZ_CODE_ATTEMPTS_PER_MINUTE=10
KVZ_SUBMITS_PER_MINUTE=120
KVZ_STARTS_PER_MINUTE=300
KVZ_BACKUP_RETENTION_DAYS=10
KVZ_LOGIN_ADDRESS_ATTEMPTS_PER_MINUTE=30
