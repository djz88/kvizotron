{
	# A browser connecting by IP address does not send the server name (SNI), so Caddy would not know which certificate to pick.
	default_sni {$KVZ_DOMAIN}
}

{$KVZ_DOMAIN} {
	# The browser remembers for six months that this site is reached only over HTTPS. Without includeSubDomains and without preload:
	# other addresses of the same name are not locked by it and going back to HTTP stays possible. Over an IP address or with an
	# untrusted certificate the browser ignores the header (docs/deployment.md).
	# ">" replaces the header the application sends as well (ADR-0066).
	header >Strict-Transport-Security "max-age=15552000"

	# ADR-0028: the largest uploaded file is 15 MB, the rest is headroom for the form.
	# ADR-0045: import accepts a ZIP of up to 100 MB.
	# ADR-0047: one submission carries all photos of an attempt; the application accepts multipart only from an attempt with a photo.
	@large path /admin/import/* /a/*/submit
	@other not path /admin/import/* /a/*/submit
	request_body @large {
		max_size 101MiB
	}
	request_body @other {
		max_size 16MiB
	}
	# Gunicorn closes an idle connection after 2 s. A POST sent on a connection closed at that moment gets
	# a reset and Caddy answers 502 (`make load` showed it), so Caddy closes idle connections earlier.
	reverse_proxy app:8000 {
		transport http {
			keepalive 1s
		}
	}
}
