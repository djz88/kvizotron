{
	# Prohlížeč připojený přes IP adresu neposílá jméno serveru (SNI) a Caddy by nevěděl, který certifikát vybrat.
	default_sni {$KVZ_DOMAIN}
}

{$KVZ_DOMAIN} {
	# Prohlížeč si šest měsíců pamatuje, že se sem chodí jen přes HTTPS. Bez includeSubDomains a bez preload:
	# jiné adresy téhož jména se tím nezamknou a návrat na HTTP zůstává možný. Přes IP adresu ani s
	# nedůvěryhodným certifikátem prohlížeč hlavičku ignoruje (docs/deployment.md).
	header Strict-Transport-Security "max-age=15552000"

	# ADR-0028: největší nahrávaný soubor má 15 MB, zbytek je rezerva na formulář.
	# ADR-0045: import přijímá ZIP do 100 MB.
	# ADR-0047: jedno odeslání nese všechny fotky pokusu; aplikace přijímá multipart jen od pokusu s fotkou.
	@large path /admin/import/* /a/*/submit
	@other not path /admin/import/* /a/*/submit
	request_body @large {
		max_size 101MB
	}
	request_body @other {
		max_size 16MB
	}
	# Gunicorn zavře nečinné spojení po 2 s. POST poslaný na spojení zavřené právě tehdy dostane
	# reset a Caddy odpoví 502 (ukázal to `make load`), proto Caddy nečinná spojení zavře dřív.
	reverse_proxy app:8000 {
		transport http {
			keepalive 1s
		}
	}
}
