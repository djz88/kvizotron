#: manifest.py plugin.py
msgid "Matching"
msgstr "Přiřazení"

#: manifest.py
msgid "Questions that pair items or put them in order."
msgstr "Otázky, které páruje položky nebo je řadí."

#: plugin.py
#, python-format
msgid "Two rows have the same text: %(text)s"
msgstr "Dva řádky mají stejný text: %(text)s"

#: plugin.py
msgid "Every pair needs both sides."
msgstr "Každá dvojice potřebuje obě strany."

#: plugin.py
msgid "The question has no text in any language."
msgstr "Otázka nemá text v žádném jazyce."

#: plugin.py
msgid "This is not valid JSON."
msgstr "Tohle není platný JSON."

#: plugin.py
msgid "Write up to 8 items in a list named items."
msgstr "Napište nejvýš 8 položek do seznamu items."

#: plugin.py
msgid "The mode must be pairs or order."
msgstr "Režim musí být pairs nebo order."

#: plugin.py
msgid "Texts must be listed by language."
msgstr "Texty se uvádějí podle jazyků."

#: jinja2/matching/admin.html plugin.py
msgid "Question"
msgstr "Otázka"

#: plugin.py
msgid "Row"
msgstr "Řádek"

#: jinja2/matching/admin.html plugin.py
msgid "Matches"
msgstr "Patří k"

#: plugin.py
msgid "Order of rows"
msgstr "Pořadí řádků"

#: jinja2/matching/admin.html plugin.py
msgid "Ordering"
msgstr "Seřazení"

#: jinja2/matching/admin.html plugin.py
msgid "Pairs"
msgstr "Spojení dvojic"

#: jinja2/matching/admin.html plugin.py
msgid "Kind"
msgstr "Druh"

#: jinja2/matching/admin.html plugin.py
msgid "From top to bottom"
msgstr "Shora dolů"

#: jinja2/matching/admin.html plugin.py
msgid "From bottom to top"
msgstr "Zdola nahoru"

#: plugin.py
msgid "Direction"
msgstr "Směr"

#: jinja2/matching/admin.html
msgid "Direction shown to the participant"
msgstr "Směr, který účastník uvidí"

#: jinja2/matching/admin.html
msgid "Rows"
msgstr "Řádky"

#: jinja2/matching/admin.html
msgid "Write pairs as they belong together, and for ordering the rows from first to last. Participants see them in a different order. Leave unused rows empty."
msgstr "Dvojice pište tak, jak k sobě patří, a u seřazení řádky od prvního po poslední. Účastník je uvidí v jiném pořadí. Nepoužité řádky nechte prázdné."

#: jinja2/matching/public_order.html
msgid "Arrange from bottom to top: the first belongs at the bottom."
msgstr "Seřaďte zdola nahoru: první patří dolů."

#: jinja2/matching/public_order.html
msgid "Arrange from top to bottom: the first belongs at the top."
msgstr "Seřaďte shora dolů: první patří nahoru."

#: jinja2/matching/public_order.html
msgid "Move up"
msgstr "Posunout nahoru"

#: jinja2/matching/public_order.html
msgid "Move down"
msgstr "Posunout dolů"

#: jinja2/matching/public_order.html
#, python-brace-format
msgid "Moved to position {n}"
msgstr "Přesunuto na pozici {n}"

#: jinja2/matching/public_order.html
#, python-format
msgid "Position of: %(text)s"
msgstr "Pozice položky: %(text)s"

#: jinja2/matching/public_order.html
msgid "Position"
msgstr "Pozice"

#: jinja2/matching/public_order.html
msgid "Each position can be used once."
msgstr "Každou pozici lze použít jen jednou."

#: jinja2/matching/public_pairs.html
msgid "Choose"
msgstr "Vyberte"

#: jinja2/matching/public_pairs.html
msgid "Each option can be used once."
msgstr "Každou možnost lze použít jen jednou."

#: jinja2/matching/solution.html
#, python-format
msgid "you placed it at %(position)s"
msgstr "vy jste dali na %(position)s. místo"

#: jinja2/matching/solution.html
#, python-format
msgid "your answer: %(answer)s"
msgstr "vaše odpověď: %(answer)s"

