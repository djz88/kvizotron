#: manifest.py
msgid "Text answer"
msgstr "Textová odpověď"

#: manifest.py
msgid "Questions answered by typing a text."
msgstr "Otázky s odpovědí napsaným textem."

#: plugin.py
msgid "Each blank can stand only once in the question's text."
msgstr "Každá mezera smí být v textu otázky jen jednou."

#: plugin.py
msgid "Image"
msgstr "Obrázek"

#: plugin.py
msgid "No copy"
msgstr "Bez kopie"

#: plugin.py
msgid "Image address"
msgstr "Adresa obrázku"

#: plugin.py
msgid "Image description"
msgstr "Popis obrázku"

#: plugin.py
#, python-format
msgid "A question can have at most %(count)s blanks."
msgstr "Otázka může mít nejvýše %(count)s mezer."

#: plugin.py
#, python-brace-format
msgid "Number the blanks in order from {1}, without a gap."
msgstr "Mezery číslujte popořadě od {1}, bez vynechání."

#: plugin.py
msgid "Text"
msgstr "Text"

#: plugin.py
msgid "Every language must use the same blanks."
msgstr "Každý jazyk musí používat stejné mezery."

#: plugin.py
msgid "Every blank needs its accepted answers."
msgstr "Každá mezera potřebuje přijímané odpovědi."

#: plugin.py
msgid "An image has no description in this language."
msgstr "Obrázek nemá v tomto jazyce popis."

#: jinja2/text/admin.html jinja2/text/public.html jinja2/text/solution.html
#: plugin.py
#, python-format
msgid "Blank %(number)s"
msgstr "Mezera %(number)s"

#: plugin.py
msgid "A row of answers has no blank in the question's text."
msgstr "Řádek odpovědí nemá mezeru v textu otázky."

#: plugin.py
msgid "The question has no text in any language."
msgstr "Otázka nemá text v žádném jazyce."

#: plugin.py
msgid "Write true or false here."
msgstr "Sem patří true nebo false."

#: jinja2/text/admin.html plugin.py
msgid "Question"
msgstr "Otázka"

#: plugin.py
#, python-format
msgid "Accepted answers for blank %(number)s"
msgstr "Přijímané odpovědi pro mezeru %(number)s"

#: jinja2/text/admin.html plugin.py
msgid "Ignore letter case"
msgstr "Nerozlišovat velikost písmen"

#: jinja2/text/admin.html plugin.py
msgid "Ignore extra spaces"
msgstr "Nerozlišovat mezery navíc"

#: jinja2/text/admin.html plugin.py
msgid "Ignore diacritics"
msgstr "Nerozlišovat diakritiku"

#: plugin.py
msgid "Yes"
msgstr "Ano"

#: plugin.py
msgid "No"
msgstr "Ne"

#: jinja2/text/admin.html
#, python-brace-format
msgid "For blanks inside the sentence, write {1}, {2} where each one belongs, in any order per language. Without them, the participant gets one field under the question. To show a brace, write {{."
msgstr "Pro mezery ve větě napište {1}, {2} tam, kam patří, v každém jazyce v libovolném pořadí. Bez nich dostane účastník jedno pole pod otázkou. Složenou závorku zapíšete jako {{."

#: jinja2/text/admin.html
msgid "Accepted answers"
msgstr "Přijímané odpovědi"

#: jinja2/text/admin.html
msgid "One per line. An answer counts if it matches any of them, in any language."
msgstr "Každou na řádek. Odpověď platí, když odpovídá kterékoli z nich v kterémkoli jazyce."

#: jinja2/text/admin.html
msgid "How answers are compared"
msgstr "Jak se odpovědi porovnávají"

#: jinja2/text/admin.html
msgid "Ignoring diacritics applies to Latin letters only, so Plzen matches Plzeň, while Cyrillic letters stay as they are."
msgstr "Nerozlišování diakritiky platí jen pro latinku, takže Plzen odpovídá Plzeň, zatímco cyrilice zůstává beze změny."

#: jinja2/text/public.html
msgid "Fill in the blanks"
msgstr "Doplňte chybějící slova"

#: jinja2/text/public.html
msgid "Your answer"
msgstr "Vaše odpověď"

#: jinja2/text/solution.html
#, python-format
msgid "your answer: %(answer)s"
msgstr "vaše odpověď: %(answer)s"

