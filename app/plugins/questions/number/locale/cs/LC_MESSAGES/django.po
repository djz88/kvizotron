#: plugin.py:68
msgid "The correct value must be a number, such as 3,14."
msgstr "Správná hodnota musí být číslo, například 3,14."

#: plugin.py:71
msgid "This kind of tolerance is not known."
msgstr "Tento druh tolerance není známý."

#: plugin.py:77
msgid "The tolerance must be a number, such as 0,5."
msgstr "Tolerance musí být číslo, například 0,5."

#: plugin.py:79
msgid "The tolerance cannot be negative."
msgstr "Tolerance nemůže být záporná."

#: plugin.py:81
msgid "A tolerance in percent cannot be used when the correct value is 0."
msgstr "Toleranci v procentech nelze použít, když je správná hodnota 0."

