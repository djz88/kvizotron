#: manifest.py plugin.py
msgid "Number"
msgstr "Číslo"

#: manifest.py
msgid "Questions answered with a number."
msgstr "Otázky s odpovědí číslem."

#: plugin.py
msgid "The correct value must be a number, such as 3,14."
msgstr "Správná hodnota musí být číslo, například 3,14."

#: plugin.py
msgid "This kind of tolerance is not known."
msgstr "Tento druh tolerance není známý."

#: plugin.py
msgid "The tolerance must be a number, such as 0,5."
msgstr "Tolerance musí být číslo, například 0,5."

#: plugin.py
msgid "The tolerance cannot be negative."
msgstr "Tolerance nemůže být záporná."

#: plugin.py
msgid "A tolerance in percent cannot be used when the correct value is 0."
msgstr "Toleranci v procentech nelze použít, když je správná hodnota 0."

#: plugin.py
msgid "Image"
msgstr "Obrázek"

#: plugin.py
msgid "No copy"
msgstr "Bez kopie"

#: plugin.py
msgid "Image address"
msgstr "Adresa obrázku"

#: plugin.py
msgid "Image description"
msgstr "Popis obrázku"

#: jinja2/number/admin.html plugin.py
msgid "Exact value"
msgstr "Přesná hodnota"

#: jinja2/number/admin.html plugin.py
msgid "Plus or minus"
msgstr "Plus minus"

#: jinja2/number/admin.html plugin.py
msgid "Percent"
msgstr "Procenta"

#: plugin.py
msgid "An image has no description in this language."
msgstr "Obrázek nemá v tomto jazyce popis."

#: plugin.py
msgid "The question has no text in any language."
msgstr "Otázka nemá text v žádném jazyce."

#: plugin.py
msgid "The correct value is missing."
msgstr "Chybí správná hodnota."

#: jinja2/number/admin.html plugin.py
msgid "Question"
msgstr "Otázka"

#: jinja2/number/admin.html plugin.py
msgid "Correct value"
msgstr "Správná hodnota"

#: jinja2/number/admin.html plugin.py
msgid "Tolerance"
msgstr "Tolerance"

#: plugin.py
msgid "Kind of tolerance"
msgstr "Druh tolerance"

#: jinja2/number/admin.html
msgid "Correct answer"
msgstr "Správná odpověď"

#: jinja2/number/admin.html
msgid "Write a unit in the question's text, not here."
msgstr "Jednotku napište do textu otázky, ne sem."

#: jinja2/number/admin.html
msgid "How much"
msgstr "Kolik"

#: jinja2/number/admin.html
msgid "Both limits count as right: 1000 with 5 percent accepts 950 to 1050."
msgstr "Obě meze se počítají jako správné: 1000 s 5 procenty přijme 950 až 1050."

#: jinja2/number/public.html
msgid "Your answer"
msgstr "Vaše odpověď"

#: jinja2/number/public.html
msgid "Write digits only, with a comma or dot for decimals."
msgstr "Pište jen číslice, desetinná místa oddělte čárkou nebo tečkou."

#: jinja2/number/public.html
#, python-brace-format
msgid "“{value}” is read as {read}: a comma or a dot is a decimal sign. Type a large number without a separator."
msgstr "„{value}“ se čte jako {read}: čárka i tečka jsou desetinné. Velké číslo pište bez oddělovače."

#: jinja2/number/solution.html
#, python-format
msgid "your answer: %(answer)s"
msgstr "vaše odpověď: %(answer)s"

