#: manifest.py plugin.py
msgid "Number"
msgstr "Число"

#: manifest.py
msgid "Questions answered with a number."
msgstr "Запитання, на які відповідають числом."

#: plugin.py
msgid "The correct value must be a number, such as 3,14."
msgstr "Правильне значення має бути числом, наприклад 3,14."

#: plugin.py
msgid "This kind of tolerance is not known."
msgstr "Цей вид допуску невідомий."

#: plugin.py
msgid "The tolerance must be a number, such as 0,5."
msgstr "Допуск має бути числом, наприклад 0,5."

#: plugin.py
msgid "The tolerance cannot be negative."
msgstr "Допуск не може бути від'ємним."

#: plugin.py
msgid "A tolerance in percent cannot be used when the correct value is 0."
msgstr "Допуск у відсотках не можна використати, коли правильне значення дорівнює 0."

#: plugin.py
msgid "Image"
msgstr "Зображення"

#: plugin.py
msgid "No copy"
msgstr "Без копії"

#: plugin.py
msgid "Image address"
msgstr "Адреса зображення"

#: plugin.py
msgid "Image description"
msgstr "Опис зображення"

#: jinja2/number/admin.html plugin.py
msgid "Exact value"
msgstr "Точне значення"

#: jinja2/number/admin.html plugin.py
msgid "Plus or minus"
msgstr "Плюс-мінус"

#: jinja2/number/admin.html plugin.py
msgid "Percent"
msgstr "Відсотки"

#: plugin.py
msgid "An image has no description in this language."
msgstr "Зображення не має опису цією мовою."

#: plugin.py
msgid "The question has no text in any language."
msgstr "Запитання не має тексту жодною мовою."

#: plugin.py
msgid "The correct value is missing."
msgstr "Бракує правильного значення."

#: jinja2/number/admin.html plugin.py
msgid "Question"
msgstr "Питання"

#: jinja2/number/admin.html plugin.py
msgid "Correct value"
msgstr "Правильне значення"

#: jinja2/number/admin.html plugin.py
msgid "Tolerance"
msgstr "Допуск"

#: plugin.py
msgid "Kind of tolerance"
msgstr "Вид допуску"

#: jinja2/number/admin.html
msgid "Correct answer"
msgstr "Правильна відповідь"

#: jinja2/number/admin.html
msgid "Write a unit in the question's text, not here."
msgstr "Одиницю напишіть у тексті запитання, а не тут."

#: jinja2/number/admin.html
msgid "How much"
msgstr "Скільки"

#: jinja2/number/admin.html
msgid "Both limits count as right: 1000 with 5 percent accepts 950 to 1050."
msgstr "Обидві межі вважаються правильними: 1000 з 5 відсотками приймає від 950 до 1050."

#: jinja2/number/public.html
msgid "Your answer"
msgstr "Ваша відповідь"

#: jinja2/number/public.html
msgid "Write digits only, with a comma or dot for decimals."
msgstr "Пишіть лише цифри, десяткову частину відокремлюйте комою або крапкою."

#: jinja2/number/public.html
#, python-brace-format
msgid "“{value}” is read as {read}: a comma or a dot is a decimal sign. Type a large number without a separator."
msgstr "«{value}» читається як {read}: кома й крапка — десяткові роздільники. Велике число вводьте без роздільника."

#: jinja2/number/solution.html
#, python-format
msgid "your answer: %(answer)s"
msgstr "ваша відповідь: %(answer)s"

