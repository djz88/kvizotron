msgid "None of the answers"
msgstr "Žádná z odpovědí"

#: plugin.py:274
msgid "A row marked as correct has no text."
msgstr "Řádek označený jako správný nemá text."

#: plugin.py:301
msgid "The question has no text in any language."
msgstr "Otázka nemá text v žádném jazyce."

#: plugin.py:317
msgid "A letter names an option that has no text."
msgstr "Písmeno ukazuje na možnost bez textu."

