msgstr "Otázka"

#: plugin.py:412
msgid "Option"
msgstr "Možnost"

#: plugin.py:417
msgid "Order of options"
msgstr "Pořadí možností"

#: jinja2/choice/admin.html:25 plugin.py:424
msgid "Correct"
msgstr "Správná"

#: plugin.py:424
msgid "None (trick question)"
msgstr "Žádná (chyták)"

#: jinja2/choice/admin.html:47 plugin.py:430
msgid "Show the number of correct answers"
msgstr "Prozradit počet správných odpovědí"

#: plugin.py:432 plugin.py:440
msgid "Yes"
msgstr "Ano"

#: plugin.py:432 plugin.py:440
msgid "No"
msgstr "Ne"

#: jinja2/choice/admin.html:41 plugin.py:438
msgid "Participants may choose several answers"
msgstr "Účastník smí vybrat více odpovědí"

#: plugin.py:444
msgid "Kind"
msgstr "Druh"

#: jinja2/choice/admin.html:14
msgid "Options"
msgstr "Možnosti"

#: jinja2/choice/admin.html:16
msgid "Mark the correct answer."
msgstr "Označte správnou odpověď."

#: jinja2/choice/admin.html:18
msgid "Mark every correct option. With none marked, this is a trick question: only the answer \"None of the answers\" scores. Leave unused rows empty."
msgstr "Označte všechny správné možnosti. Když neoznačíte žádnou, je to chyták: body dostane jen odpověď „Žádná z odpovědí“. Nepoužité řádky nechte prázdné."

#: jinja2/choice/admin.html:43
msgid "Without this, a participant chooses one answer at most. It is needed when several options are correct."
msgstr "Bez toho vybere účastník nejvýše jednu odpověď. Je to potřeba, když je správných víc."

#: jinja2/choice/admin.html:49
msgid "A trick question shows no number, because that would give it away. In a quiz with trick questions, a missing number is a clue."
msgstr "Chyták počet neukazuje, protože by se tím prozradil. V kvízu s chytáky je chybějící počet nápovědou."

#: jinja2/choice/public.html:3
#, python-format
msgid "choose %(count)s"
msgstr "vyberte %(count)s"

#: jinja2/choice/solution.html:6 jinja2/choice/solution.html:13
msgid "correct answer"
msgstr "správná odpověď"

#: jinja2/choice/solution.html:7 jinja2/choice/solution.html:14
msgid "your answer"
msgstr "vaše odpověď"

