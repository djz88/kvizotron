#: manifest.py plugin.py
msgid "Choice"
msgstr "Výběr"

#: manifest.py
msgid "Questions with one, several or no correct answers."
msgstr "Otázky s jednou, několika nebo žádnou správnou odpovědí."

#: plugin.py
#, python-format
msgid "Two options have the same text: %(text)s"
msgstr "Dvě odpovědi mají stejný text: %(text)s"

#: plugin.py
msgid "Several options are marked as correct. Allow participants to choose several answers."
msgstr "Správných je označeno víc. Povolte účastníkům vybrat více odpovědí."

#: plugin.py
msgid "A yes/no question needs both answers and exactly one marked as correct."
msgstr "Otázka ano/ne potřebuje obě odpovědi a právě jednu označenou jako správnou."

#: plugin.py
msgid "Image"
msgstr "Obrázek"

#: plugin.py
msgid "No copy"
msgstr "Bez kopie"

#: plugin.py
msgid "Image address"
msgstr "Adresa obrázku"

#: plugin.py
msgid "Image description"
msgstr "Popis obrázku"

#: plugin.py
msgid "Write true or false here."
msgstr "Sem patří true nebo false."

#: plugin.py
msgid "Name correct options by letter, like A or A,C."
msgstr "Správné možnosti se píšou písmenem, třeba A nebo A,C."

#: plugin.py
msgid "Yes or no"
msgstr "Ano, nebo ne"

#: plugin.py
msgid "An image has no description in this language."
msgstr "Obrázek nemá v tomto jazyce popis."

#: jinja2/choice/public.html jinja2/choice/solution.html plugin.py
msgid "None of the answers"
msgstr "Žádná z odpovědí"

#: plugin.py
msgid "A row marked as correct has no text."
msgstr "Řádek označený jako správný nemá text."

#: plugin.py
msgid "The question has no text in any language."
msgstr "Otázka nemá text v žádném jazyce."

#: plugin.py
msgid "A letter names an option that has no text."
msgstr "Písmeno ukazuje na možnost bez textu."

#: jinja2/choice/admin.html plugin.py
msgid "Question"
msgstr "Otázka"

#: plugin.py
msgid "Option"
msgstr "Možnost"

#: plugin.py
msgid "Order of options"
msgstr "Pořadí možností"

#: jinja2/choice/admin.html plugin.py
msgid "Correct"
msgstr "Správná"

#: plugin.py
msgid "None (trick question)"
msgstr "Žádná (chyták)"

#: jinja2/choice/admin.html plugin.py
msgid "Show the number of correct answers"
msgstr "Prozradit počet správných odpovědí"

#: plugin.py
msgid "Yes"
msgstr "Ano"

#: plugin.py
msgid "No"
msgstr "Ne"

#: jinja2/choice/admin.html plugin.py
msgid "Participants may choose several answers"
msgstr "Účastník smí vybrat více odpovědí"

#: plugin.py
msgid "Kind"
msgstr "Druh"

#: jinja2/choice/admin.html
msgid "Options"
msgstr "Možnosti"

#: jinja2/choice/admin.html
msgid "Mark the correct answer."
msgstr "Označte správnou odpověď."

#: jinja2/choice/admin.html
msgid "Mark every correct option. With none marked, this is a trick question: only the answer \"None of the answers\" scores. Leave unused rows empty."
msgstr "Označte všechny správné možnosti. Když neoznačíte žádnou, je to chyták: body dostane jen odpověď „Žádná z odpovědí“. Nepoužité řádky nechte prázdné."

#: jinja2/choice/admin.html
msgid "Without this, a participant chooses one answer at most. It is needed when several options are correct."
msgstr "Bez toho vybere účastník nejvýše jednu odpověď. Je to potřeba, když je správných víc."

#: jinja2/choice/admin.html
msgid "A trick question shows no number, because that would give it away. In a quiz with trick questions, a missing number is a clue."
msgstr "Chyták počet neukazuje, protože by se tím prozradil. V kvízu s chytáky je chybějící počet nápovědou."

#: jinja2/choice/public.html
#, python-format
msgid "choose %(count)s"
msgstr "vyberte %(count)s"

#: jinja2/choice/solution.html
msgid "correct answer"
msgstr "správná odpověď"

#: jinja2/choice/solution.html
msgid "your answer"
msgstr "vaše odpověď"

