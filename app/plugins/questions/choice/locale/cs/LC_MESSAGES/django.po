#: plugin.py:65
#, python-format
msgid "Two options have the same text: %(text)s"
msgstr "Dvě odpovědi mají stejný text: %(text)s"

#: plugin.py:69
msgid "Several options are marked as correct. Allow participants to choose several answers."
msgstr "Správných je označeno víc. Povolte účastníkům vybrat více odpovědí."

#: plugin.py:73
msgid "A yes/no question needs both answers and exactly one marked as correct."
msgstr "Otázka ano/ne potřebuje obě odpovědi a právě jednu označenou jako správnou."

