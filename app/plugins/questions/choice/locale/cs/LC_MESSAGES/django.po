msgstr "Popis obrázku"

#: plugin.py:102
msgid "Write true or false here."
msgstr "Sem patří true nebo false."

#: plugin.py:114
msgid "Name correct options by letter, like A or A,C."
msgstr "Správné možnosti se píšou písmenem, třeba A nebo A,C."

#: plugin.py:132 plugin.py:443
msgid "Choice"
msgstr "Výběr"

#: plugin.py:153 plugin.py:443
msgid "Yes or no"
msgstr "Ano, nebo ne"

#: plugin.py:178
msgid "An image has no description in this language."
msgstr "Obrázek nemá v tomto jazyce popis."

