#: manifest.py
msgid "Do not ask"
msgstr "Neptat se"

#: manifest.py
msgid "Ask, may be left empty"
msgstr "Zeptat se, jde nechat prázdné"

#: manifest.py
msgid "Require"
msgstr "Vyžadovat"

#: manifest.py
msgid "Participants"
msgstr "Účastníci"

#: manifest.py
msgid "Decides who may take part and how names and e-mails are asked for."
msgstr "Určuje, kdo se může zúčastnit a jak se ptát na jméno a e-mail."

#: manifest.py
msgid "Attempt repeats"
msgstr "Opakování pokusu"

#: manifest.py
msgid "Anyone may play again"
msgstr "Každý může hrát znovu"

#: manifest.py
msgid "One attempt per browser"
msgstr "Jeden pokus na prohlížeč"

#: manifest.py
msgid "The browser is recognised by a cookie, so another browser or a cleared cookie starts a new attempt."
msgstr "Prohlížeč se pozná podle cookie, takže jiný prohlížeč nebo smazané cookie začne nový pokus."

#: manifest.py
msgid "An unfinished attempt"
msgstr "Nedokončený pokus"

#: manifest.py
msgid "The participant continues it"
msgstr "Účastník v něm pokračuje"

#: manifest.py
msgid "It counts as the one attempt"
msgstr "Počítá se jako jediný pokus"

#: manifest.py
msgid "It is closed and a new one may start"
msgstr "Uzavře se a může začít nový"

#: manifest.py
msgid "Matters when an attempt may not be repeated or the number of attempts is limited."
msgstr "Záleží, když se pokus nesmí opakovat nebo je počet pokusů omezený."

#: manifest.py
msgid "At most attempts"
msgstr "Nejvýš pokusů"

#: manifest.py
msgid "No limit"
msgstr "Bez limitu"

#: manifest.py
msgid "Counted from the attempts a browser has sent in this run."
msgstr "Počítá se z pokusů, které prohlížeč v tomto běhu odeslal."

#: manifest.py
msgid "More attempts after passing"
msgstr "Další pokusy po splnění"

#: manifest.py
msgid "Allowed"
msgstr "Povoleny"

#: manifest.py
msgid "Not after passing"
msgstr "Po splnění už ne"

#: manifest.py
msgid "Needs a pass mark."
msgstr "Vyžaduje hranici úspěšnosti."

#: manifest.py
msgid "Nickname"
msgstr "Přezdívka"

#: manifest.py
msgid "The administration of this run shows it, and so does the run's public scoreboard when the admin turns it on."
msgstr "Ukazuje ji administrace tohoto běhu a také veřejný žebříček běhu, když ho správce zapne."

#: manifest.py
msgid "E-mail"
msgstr "E-mailová adresa"

#: manifest.py
msgid "An e-mail is shown only to logged-in administrators, never publicly."
msgstr "E-mail vidí jen přihlášení správci, nikdy veřejnost."

#: manifest.py
msgid "When to ask"
msgstr "Kdy se ptát"

#: manifest.py
msgid "After the last question"
msgstr "Po poslední otázce"

#: manifest.py
msgid "Before the first question"
msgstr "Před první otázkou"

#: manifest.py
msgid "Applies to the nickname and the e-mail."
msgstr "Platí pro přezdívku i e-mail."

#: manifest.py
msgid "Same nickname twice"
msgstr "Stejná přezdívka dvakrát"

#: manifest.py
msgid "Allow"
msgstr "Povolit"

#: manifest.py
msgid "Refuse within one run"
msgstr "Odmítnout v rámci jednoho běhu"

#: manifest.py
msgid "Names differing only by case or inner spaces count as the same."
msgstr "Jména lišící se jen velikostí písmen nebo mezerami uvnitř se berou jako stejná."

