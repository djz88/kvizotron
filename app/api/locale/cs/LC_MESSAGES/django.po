msgid "Your photo"
msgstr "Vaše fotka"

#: jinja2/public/result.html:22
#, python-format
msgid "Points: %(earned)s of %(maximum)s"
msgstr "Body: %(earned)s z %(maximum)s"

#: jinja2/public/walkthrough.html:6
msgid "The answers of this run."
msgstr "Odpovědi tohoto běhu."

#: jinja2/public/walkthrough.html:12
msgid "Correct answer"
msgstr "Správná odpověď"

#: jinja2/public/walkthrough.html:15
msgid "What people answered"
msgstr "Co lidé odpověděli"

#: jinja2/public/walkthrough.html:26
msgid "Show again"
msgstr "Znovu ukázat"

#: jinja2/public/walkthrough.html:26
msgid "Hide"
msgstr "Skrýt"

#: jinja2/public/walkthrough.html:36
msgid "A participant's photo"
msgstr "Fotka účastníka"

