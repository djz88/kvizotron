#: manifest.py:26
msgid "Images from an address"
msgstr "Зображення за адресою"

#: manifest.py:28
msgid "Show a copy kept here"
msgstr "Показувати копію, збережену тут"

#: manifest.py:29
msgid "Load them from their server"
msgstr "Завантажувати з їхнього сервера"

#: manifest.py:31
msgid "A server that images load from sees the IP addresses of participants."
msgstr "Сервер, з якого завантажуються зображення, бачить IP-адреси учасників."

#: manifest.py:39
msgid "Fetching images from the internal network"
msgstr "Завантаження зображень із внутрішньої мережі"

#: manifest.py:40
msgid "Refuse"
msgstr "Відмовити"

#: manifest.py:40
msgid "Allow"
msgstr "Дозволити"

#: manifest.py:42
msgid "Any admin can turn this on, so a stolen admin account could use it to reach the internal network."
msgstr "Увімкнути це може будь-який адміністратор, тому викрадений обліковий запис адміністратора може отримати доступ до внутрішньої мережі."

#: provider.py:61
msgid "This file is not a usable image. Use PNG, JPEG, WebP, GIF or SVG."
msgstr "Цей файл не є придатним зображенням. Використайте PNG, JPEG, WebP, GIF або SVG."

#: provider.py:65
#, python-format
msgid "This file is too large. The limit is %(mb)s MB."
msgstr "Файл завеликий. Обмеження: %(mb)s МБ."

#: provider.py:162
msgid "HEIC photos cannot be used. Save the photo as JPEG on the phone and upload it again."
msgstr "Фото HEIC не можна використати. Збережіть фото в телефоні як JPEG і завантажте знову."

#: provider.py:180
msgid "This file is not a usable photo. Use PNG, JPEG or WebP."
msgstr "Цей файл не є придатним фото. Використайте PNG, JPEG або WebP."

#: provider.py:223
msgid "This run cannot take any more photos."
msgstr "Цей запуск більше не може прийняти фото."

#: provider.py:258
msgid "Enter a whole address starting with https://, with no login in it."
msgstr "Введіть повну адресу, що починається з https://, без облікових даних."

#: provider.py:273
msgid "This address is in an internal network, which the settings do not allow."
msgstr "Ця адреса у внутрішній мережі, а налаштування цього не дозволяють."

#: provider.py:276
msgid "The image could not be fetched from this address."
msgstr "Не вдалося завантажити зображення з цієї адреси."

