# Generated by heimdall. The quality target is the single source of truth for CI: CI should call
# `make quality`, not its own commands. `make lint fix` runs lint with fixes (the lint command
# uses $(LINT_FIX) for it, if the tool can fix).
.DEFAULT_GOAL := help
LINT_FIX := $(if $(filter fix,$(MAKECMDGOALS)),--fix)
WT_DIR := .worktrees
WT_NAME = $(or $(name),$(word 2,$(MAKECMDGOALS)))
export WT_NAME
# pre-commit runs on Python 3.14: it needs PyYAML, which has no wheel for 3.15.
PRE_COMMIT := uvx --python 3.14 pre-commit@4.7.0
# compose cannot read the file without them; no container is started with them.
COMPOSE_IMAGES := KVZ_SECRET_KEY=unused KVZ_DOMAIN=localhost docker compose -f deploy/compose.yaml
TECH_DEBT := python3 tools/tech_debt.py --doc docs/_architecture/TECH_DEBT.md
# Versions the project wants. uv: `[tool.uv] required-version` in pyproject.toml, completed to x.y.z;
# the Dockerfile installs the same one (tests/test_makefile.py checks it). Python and packages: pyproject.toml and uv.lock.
# Hooky: .pre-commit-config.yaml. Image: digesty v Dockerfile a deploy/compose.yaml.
UV_REQUIRED := $(shell sed -n 's/^required-version *= *">=\([0-9.]*\)".*/\1/p' pyproject.toml 2>/dev/null | awk -F. '{print $$1"."$$2"."($$3==""?0:$$3)}')
.PHONY: wiring plan-check help env-update setup setup-reset doctor clean lint test secrets quality smoke load hooks private-traces fix messages worktree worktree-create worktree-remove tech-debt-check tech-debt-tidy tech-debt-create tech-debt-resolve

# The name after the target (make worktree-create NAME) is not looked up by make as another target.
ifneq ($(filter worktree-create worktree-remove,$(MAKECMDGOALS)),)
.DEFAULT: ; @:
endif

help: ## Lists the targets
	@grep -E '^[a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) | sed -E 's/^([a-zA-Z_-]+):[^#]*## (.*)$$/  \1  \2/'

env-update: ## Installs the versions the project declares: uv, Python and packages, pre-commit with hooks, Docker image
	uv self update $(UV_REQUIRED)
	uv sync --frozen
	$(PRE_COMMIT) install --install-hooks
	$(COMPOSE_IMAGES) pull --ignore-buildable
	$(COMPOSE_IMAGES) build --pull

setup: ## Installs dependencies
	uv sync --frozen

setup-reset: clean setup ## Rebuilds the environment from scratch: clean and setup

doctor: ## Checks the tools: uv, docker, docker compose, pre-commit hooks
	@uv --version
	@uv --version | awk -v want="$(UV_REQUIRED)" '{split($$2, v, "."); split(want, w, "."); for (i = 1; i <= 3; i++) { if (v[i] + 0 > w[i] + 0) exit 0; if (v[i] + 0 < w[i] + 0) { print "uv is too old, the project wants " want " or newer: make env-update"; exit 1 } }}'
	@docker --version
	@docker compose version
	@test -f .git/hooks/pre-commit && echo "pre-commit hook: ok" || echo "pre-commit hook: missing, run make env-update"
	@python3 tools/private_traces.py list || true

# Deliberately a list of paths, not `git clean -X`: that would also delete .env, databases and backups.
clean: ## Deletes the build environment: .venv, tool caches and build outputs; data is not deleted
	rm -rf .venv .pytest_cache .ruff_cache .mypy_cache .coverage htmlcov dist build
	find . -type d \( -name .git -o -name .worktrees \) -prune -o -type d -name __pycache__ -prune -exec rm -rf {} +

lint: ## Lint (make lint fix = with fixes)
	uv run ruff check $(LINT_FIX) .
	uv run ruff format $(if $(LINT_FIX),,--check) .
	uv run mypy

fix: ; @:

test: ## Tests
	uv run pytest

secrets: ## Looks for secrets (gitleaks) in staged changes and in git history
	$(PRE_COMMIT) run --all-files
	$(PRE_COMMIT) run --all-files --hook-stage manual gitleaks-history

quality: lint test secrets tech-debt-check ## Lint, tests, gitleaks and the TECH_DEBT.md check (the same runs in CI)

wiring: ## Wiring checks only: modules, templates, URLs, scripts, styles, settings
	uv run pytest tests/test_wiring.py -q

plan-check: ## Did the files named in the plan change? make plan-check plan=path.md base=main
	@test -n "$(plan)" || { echo "Usage: make plan-check plan=docs/superpowers/plans/x.md [base=main]"; exit 2; }
	python3 -m tools.plan_check --plan "$(plan)" --base "$(or $(base),main)"

smoke: ## Verifies the deployment: Docker Compose, Caddy, application health
	sh deploy/smoke.sh

load: ## Load test: 50 participants submit photos at once during a backup, restore and address check (Docker, minutes)
	sh deploy/load.sh

messages: ## Extracts texts for translation and compiles the catalogs (locale/)
	uv run python -m tools.messages

hooks: ## Installs git hooks for commit, commit message and push
	$(PRE_COMMIT) install
	@python3 tools/private_traces.py list || true

private-traces: ## Creates an empty .git/info/private-traces (personal words, outside git); leaves an existing one
	@list="$$(git rev-parse --path-format=absolute --git-common-dir)/info/private-traces"; \
	if [ -f "$$list" ]; then echo "private-traces: $$list already exists"; \
	else mkdir -p "$$(dirname "$$list")" && printf '%s\n' \
	  '# Personal words that must not enter the repository: name, home network address, e-mail.' \
	  '# One per line, case does not matter; # is a comment. Checked by tools/private_traces.py.' \
	  > "$$list" && echo "private-traces: created $$list"; fi

worktree: ## Lists worktrees
	@git worktree list

worktree-create: ## Creates a worktree: make worktree-create NAME (branch NAME in .worktrees/NAME)
	@case "$$WT_NAME" in ''|-*|/*|*..*|*[!A-Za-z0-9._/-]*) echo "Usage: make worktree-create NAME (letters, digits, . _ / -)" >&2; exit 1;; esac
	git worktree add "$(WT_DIR)/$$WT_NAME" -b "$$WT_NAME"

worktree-remove: ## Removes a worktree and deletes the branch only if it is merged
	@case "$$WT_NAME" in ''|-*|/*|*..*|*[!A-Za-z0-9._/-]*) echo "Usage: make worktree-remove NAME (letters, digits, . _ / -)" >&2; exit 1;; esac
	git worktree remove "$(WT_DIR)/$$WT_NAME"
	git branch -d "$$WT_NAME"

tech-debt-check: ## Checks TECH_DEBT.md and the archive
	@$(TECH_DEBT) check

tech-debt-tidy: ## Moves resolved items to the archive
	@$(TECH_DEBT) tidy

tech-debt-create: ## Creates an item: make tech-debt-create title="Title"
	@test -n "$$title" || { echo 'Usage: make tech-debt-create title="Title"' >&2; exit 1; }
	@$(TECH_DEBT) create "$$title"

tech-debt-resolve: ## Resolves an item: make tech-debt-resolve id=TD-NNN
	@test -n "$$id" || { echo "Usage: make tech-debt-resolve id=TD-NNN" >&2; exit 1; }
	@$(TECH_DEBT) resolve "$$id"
